{
  "name": "Bh · Bootstrap Helpers",
  "short_name": "Bh",
  "description": "Bootstrap 6 in a Rails app, with the markup already written.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#F056B4",
  "background_color": "#FFE9F6",
  "icons": [
    { "src": "web-app-manifest-192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "web-app-manifest-512x512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
